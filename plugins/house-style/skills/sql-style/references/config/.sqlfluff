# House PostgreSQL profile for SQLFluff 4.5.0.
# Copy to a consuming repo's root or pass --ignore-local-config --config PATH.
# Plain SQL only. Jinja/dbt projects need their own templater configuration.
[sqlfluff]
dialect = postgres
templater = raw
# Explicit IDs keep upgrades from silently adding new policy.
rules = AL01,AL02,AL03,AL04,AL05,AL06,AL08,AL09,AL10,AM01,AM02,AM03,AM04,AM05,AM06,AM07,AM08,AM09,CP01,CP02,CP03,CP04,CP05,CV01,CV02,CV03,CV04,CV05,CV06,CV07,CV08,CV11,CV12,LT01,LT02,LT03,LT04,LT05,LT06,LT07,LT08,LT09,LT10,LT11,LT12,LT13,LT14,LT15,RF01,RF02,RF03,RF04,RF05,RF06,ST01,ST02,ST03,ST04,ST05,ST07,ST08,ST09,ST10,ST11,ST12
encoding = utf-8
max_line_length = 100
warn_unused_ignores = True
fix_even_unparsable = False
# Never silently pass a migration skipped because of its size.
large_file_skip_fail = True
processes = 1
# Use the nonexperimental parser consistently across installations.
use_rust_parser = False

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 2
implicit_indents = forbid

[sqlfluff:rules]
# Computed outputs need names even in single-target queries.
allow_scalar = False
single_table_references = consistent
unquoted_identifiers_policy = all

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:aliasing.length]
min_alias_length = 4

[sqlfluff:rules:ambiguous.join]
fully_qualify_join_types = inner

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = explicit

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
# Lowercase is safe for unquoted PostgreSQL identifiers; inserting underscores
# into existing names with the "snake" fixer could change object references.
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:convention.not_equal]
preferred_not_equal_style = ansi

[sqlfluff:rules:convention.count_rows]
prefer_count_1 = False
prefer_count_0 = False

[sqlfluff:rules:convention.terminator]
require_final_semicolon = True

[sqlfluff:rules:convention.casting_style]
preferred_type_casting_style = cast

[sqlfluff:rules:references.keywords]
unquoted_identifiers_policy = all
# Preserve necessary quoted names when integrating existing schemas.
quoted_identifiers_policy = none

[sqlfluff:rules:references.special_chars]
unquoted_identifiers_policy = all
quoted_identifiers_policy = none

[sqlfluff:rules:references.quoting]
prefer_quoted_identifiers = False
prefer_quoted_keywords = False
case_sensitive = True

[sqlfluff:rules:structure.subquery]
# FROM subqueries remain valid. Correlated/LATERAL cases need semantic review.
forbid_subquery_in = join

[sqlfluff:rules:structure.join_condition_order]
preferred_first_table_in_join_clause = earlier
