# Project-controlled C++ only. Do not pass this config to vendored or third-party code.
# Validated with clang-format 23.1.3. [GOOGLE-CPP] [CLANG-FORMAT]
BasedOnStyle: Google
Language: Cpp
Standard: c++20
# Chromium's stricter control-body policy. Review inserted braces.
InsertBraces: true
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
DerivePointerAlignment: false
PointerAlignment: Left
